{
  "name": "deezer/test-tech",
  "description": "Deezer Test Tech",
  "homepage": "https://github.com/albert-barreto/deezer",
  "require": {
    "php": ">=8.1",
    "ext-PDO": "*",
    "slim/slim": "^3.12.5",
    "monolog/monolog": "^2.9",
    "slim/twig-view": "^2.5",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Deezer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Deezer\\": "src/",
      "Tests\\": "tests"
    }
  },
  "config": {
    "process-timeout": 0
  },
  "scripts": {
    "start": "php -S localhost:8787 -t public",
    "test": "phpunit"
  }
}
